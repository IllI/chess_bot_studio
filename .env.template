# Lichess Bot Configuration
# Copy this file to .env and fill in your actual values

# Lichess API Token for your bot account
# Get this from: https://lichess.org/account/oauth/token
LICHESS_TOKEN=your_lichess_bot_token_here

# Optional: Additional bot tokens for multi-bot testing
# LICHESS_TOKEN_BOT2=your_second_bot_token_here
# LICHESS_TOKEN_BOT3=your_third_bot_token_here

# Bot Configuration
BOT_NAME=ChessEngineTuner
DEFAULT_SEARCH_DEPTH=4

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=chess_engine_tuner.log